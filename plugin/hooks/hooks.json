{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\session-start.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/gate.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\gate.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "task|task_append",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dispatch.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\dispatch.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write|edit|multiedit|notebookedit|bash|run_code|mavis",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/guard.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\guard.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "read|glob|grep|list|search|task_output|task_query|task_stop",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/guard.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\guard.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mavis_agent_delete|mavis_agent_update|mavis_agent_create|website_deploy|miniapp|miniapp_publish",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/guard.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\guard.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "read|glob|grep|list|search|write|edit|multiedit|notebookedit|bash|run_code|mavis|task|task_output|task_query|task_stop",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/loop-gate.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\loop-gate.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/dispatch.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\dispatch.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/watchdog.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\watchdog.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}